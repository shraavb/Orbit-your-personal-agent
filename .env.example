# Application
APP_NAME="Orbit Voice Agent"
DEBUG=false

# Database
DATABASE_URL="postgresql+psycopg://orbit:orbit@localhost:5432/orbit"

# LLM & Agent (Required)
ANTHROPIC_API_KEY="your-anthropic-api-key"
LANGSMITH_API_KEY="your-langsmith-api-key"
LANGSMITH_PROJECT="orbit-voice-agent"

# TTS (Required) - ElevenLabs
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
# Optional: Specify a voice ID (defaults to "Rachel" if not set)
# Popular voices: Rachel (21m00Tcm4TlvDq8ikWAM), Adam, Antoni, Bella, Josh
ELEVENLABS_VOICE_ID=""

# Messaging Integrations (Optional - add as you implement)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

GMAIL_CREDENTIALS_FILE="backend/data/gmail_credentials.json"
GMAIL_TOKEN_FILE="backend/data/gmail_token.json"

SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""

# Whisper ASR Settings
WHISPER_MODEL_SIZE="base"  # tiny, base, small, medium, large
WHISPER_DEVICE="cpu"  # cpu or cuda (if you have GPU)
WHISPER_COMPUTE_TYPE="int8"  # int8, float16, float32

# Contacts
CONTACTS_FILE="backend/data/contacts.json"
